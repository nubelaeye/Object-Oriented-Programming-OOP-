# Homework - Create Account class with 2 attributes - balance and account no.
# Create methods for debit, credit and printing the current balance..

# (Solution)..
class Account:
    
    balance = 0
    acc_no = "123XX"
    
    def __init__(self, balance, account_no):
        self.balance = balance
        self.acc_no = account_no
    
    def debit(self, money_debited):
        global balance
        balance = self.balance - money_debited
    
    def credit(self, money_credited):
        global balance
        balance = self.balance + money_credited
    
    @staticmethod
    def Curren_bal():
        print(balance)

emp01 = Account(275,"CRAZY")
emp01.credit(45)
emp01.Curren_bal()

