# HOMEWORK QUESTION - Create student class that takes name and marks of 3 subjects as args
# in a constructor. Then create a method to print their average.

# Soln-
class TakesData:
    
    def __init__(self, name, m1,m2,m3):
        self.name = name
        self.m1 = m1
        self.m2 = m2
        self.m3 = m3
    
