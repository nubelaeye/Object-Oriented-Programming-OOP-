# --- Static Methods..
# Methods that don't use the self parameter(work at class level)
# So, basically if you dont want to use any attributes of class like name or self.name..
# then you can define a static method with writing or adding "@staticmethod" also known as
# decorator.. example ->
# What is decorator? - A decorator allows us to wrap a funciton in order to extend the 
# behaviour of the wrapped function, without permanently modifying it..

class School:
    
    def __init__(self, name, marks):
        self.name = name
        self.marks = marks
        
    @staticmethod
    def hello():
        return "hello!!"

n2 = School("Jellyfish", 80)
print(n2.name)
print(n2.marks)
print(n2.hello())

